{
  "name": "bbp-training-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "esbuild node_modules/qrcode/lib/browser.js --bundle --format=iife --global-name=QRCode --footer:js=\"if(typeof window!=='undefined'){window.QRCode=QRCode;}\" --minify --outfile=public/js/qrcode-helper.js && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "qrcode": "^1.5.4",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
